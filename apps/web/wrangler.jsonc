{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "arkie-web",
  "compatibility_date": "2026-10-24",
  // No `main`: this is a static assets upload, not a Worker with code behind it.
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [
    {
      "pattern": "arkie.elyon-labs.com",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  }
}
