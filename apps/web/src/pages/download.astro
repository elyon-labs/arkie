---
import { releasesUrl, site } from '@/data/site';
import BaseLayout from '@/layouts/base.astro';
import { formatBytes, platformDownloads, storeListings } from '@/lib/downloads';
import { formatReleaseDate, latestRelease } from '@/lib/releases';

const downloads = await platformDownloads();
const release = await latestRelease();
---

<BaseLayout
  title={`Download — ${site.name}`}
  description="Download Arkie for macOS, Windows or Linux. Installers for every release are published on GitHub, and Arkie for iPhone is coming soon to the App Store."
>
  <section class="section">
    <p class="section-label">Download</p>
    <h1 class="section-title">Get Arkie</h1>
    <p class="section-lede">
      One desktop app, built from the same source for all three desktops. Installers are published with
      every release, straight from this site — no store, no account.
    </p>

    <ul class="downloads">
      {
        downloads.map((download) => (
          <li class="download">
            <p class="download-platform">{download.platform}</p>
            <p class="download-format">
              {download.format}
              {download.size !== null && ` · ${formatBytes(download.size)}`}
            </p>
            <div class="download-action">
              {download.href ? (
                <a class="button" href={download.href}>
                  Download
                </a>
              ) : (
                <span class="download-pending">{download.note}</span>
              )}
            </div>
          </li>
        ))
      }
    </ul>

    {
      release && (
        <p class="download-meta">
          Latest release <a href="/releases">v{release.version}</a>, published{' '}
          {formatReleaseDate(release.publishedAt)}. Older versions are kept on{' '}
          <a href={releasesUrl}>GitHub</a>.
        </p>
      )
    }

    <div class="mobile-downloads">
      <h2>On your phone</h2>
      <p class="mobile-downloads-lede">
        Arkie for iPhone lays your servers out like an inbox and each one as a focused command
        chat, with saved commands, map changes and player management a tap away.
      </p>
      <ul class="downloads">
        {
          storeListings.map((listing) => (
            <li class="download">
              <p class="download-platform">{listing.platform}</p>
              <p class="download-format">{listing.format}</p>
              <div class="download-action">
                {listing.href ? (
                  <a class="button" href={listing.href}>
                    {`Get it on the ${listing.store}`}
                  </a>
                ) : (
                  <span class="store-badge">
                    <span class="store-badge-eyebrow">Coming soon to the</span>
                    <span class="store-badge-store">{listing.store}</span>
                  </span>
                )}
              </div>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="install-notes">
      <h2>Installing</h2>
      <dl class="spec-list">
        <div>
          <dt>macOS</dt>
          <dd>
            Open the .dmg and drag Arkie to Applications. It is signed and notarised by Apple, so
            it opens with no warning. One image covers Apple silicon and Intel.
          </dd>
        </div>
        <div>
          <dt>Windows</dt>
          <dd>
            Run the installer. It is not signed with a commercial certificate, so SmartScreen will
            warn you the first time — "More info", then "Run anyway".
          </dd>
        </div>
        <div>
          <dt>Linux</dt>
          <dd>
            Install the package for your architecture with <strong>sudo apt install
            ./arkie.deb</strong>, which pulls in the GTK libraries it needs. Debian, Ubuntu and
            their derivatives.
          </dd>
        </div>
      </dl>
    </div>
  </section>
</BaseLayout>
